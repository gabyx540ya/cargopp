#!/bin/bash

# ---- COULEURS ANSI ----
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# external scripts

REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
ROOT="$REAL_HOME/.cargopp"
#USERROOT=$(pwd)
source "$ROOT"/bin/lib/run
source "$ROOT"/bin/lib/build_cargopp
source "$ROOT"/bin/lib/new_c
source "$ROOT"/bin/lib/new_cpp
update="source '$ROOT'/bin/lib/smart_update/update"
source "$ROOT"/bin/lib/smart_update/fly

## argument initialization

if [ "$#" -lt 1 ]; then
  echo "Usage: cargopp <command> [argument]"
  exit 1
fi

COMMAND="$1"

case "$COMMAND" in
new)
  fly

  if [ "$#" -lt 2 ]; then
    echo "Usage: cargopp new <project_name> [--c]"
    exit 1
  fi

  PROJECT="$2"

  if [ "$#" -eq 2 ]; then
    new_cpp "$PROJECT"
  elif [ "$#" -eq 3 ] && [ "$3" = "--c" ]; then
    new_c "$PROJECT"
  else
    echo "Usage: cargopp new <project_name> [--c]"
    exit 1
  fi
  ;;

build)
  fly
  build_cargopp
  ;;

run)
  fly
  if [ "$#" -ne 2 ]; then
    echo "Error: cargopp run requires a program name"
    echo "Usage: cargopp run <program_name>"
    exit 1
  fi

  FILENAME="$2"
  run "$FILENAME"
  ;;
update)
  eval "$update"
  ;;
--version|version)
  fly
  echo $(cat "$ROOT"/cargopp_version)
  ;;
*)
  echo "Error: command '$COMMAND' not recognized."
  echo "Usage: cargopp <command> [argument]"
  echo ""
  echo "Commands:"
  echo "  --version            See local version"
  echo "  install              Install cargopp globally"
  echo "  new <name>           Create a new C++ project"
  echo "  new <name> --c       Create a new C project"
  echo "  build                Build the current project"
  echo "  run <program>        Build and run a program"
  exit 2
  ;;

esac
